{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "types": [
      "node"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ]
  },
  "include": [
    "backend/**/*.ts",
    "frontend/**/*.tsx",
    "frontend/**/*.ts",
    "organizer/**/*",
    "shared/**/*"
  ]
}
