# Copy needed values into the process environment; this file is not loaded automatically.
SERVICE_PORT=3811
SERVICE_HOST=127.0.0.1
SERVICE_DATA_DIR=documents-data
APP_RELEASE=development
# Stable, independent server-only secrets are required for persistent sessions.
# SERVICE_TOKEN_SECRET=
# SERVICE_NODE_TOKEN=
# CSV processing uses a local Python interpreter; the Docker image includes Python 3.
# DOCUMENT_PYTHON=/usr/bin/python3
# Optional server-only tenant mapping; see doc/SAAS-METERING-INTEGRATION.md.
# METERING_CONNECTIONS_JSON=
# Runtime acceptance: one container, 256 MiB, sequential processors, no model or paid calls.
