# The app does not auto-load this file. Set process environment or use node --env-file.
SERVICE_PORT=3812
SERVICE_HOST=127.0.0.1
SERVICE_DATA_DIR=metering-data
APP_RELEASE=development
# Independent server-only random values; keep stable across restarts.
# SERVICE_TOKEN_SECRET=
# SERVICE_NODE_TOKEN=
# Optional test-provider source, not payment acquiring. No outgoing requests without configuration.
# METERING_PROVIDER_URL=http://127.0.0.1:3998
# METERING_PROVIDER_SECRET=
# Explicit comma-separated origin allowlist for webhook receivers.
# METERING_WEBHOOK_ORIGINS=http://127.0.0.1:3999
