# Copy needed values into your process environment; the app does not auto-load this file.
SERVICE_PORT=3810
SERVICE_HOST=127.0.0.1
SERVICE_DATA_DIR=support-data
# Keep these server-only secrets stable across restarts. Generate independent random values.
# SERVICE_TOKEN_SECRET=
# SERVICE_NODE_TOKEN=
# External login is optional. Use a fresh data directory with SERVICE_DEMO=0.
# SERVICE_DEMO=0
# OIDC_ISSUER=https://identity.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ORIGIN=https://support.example.com
# OIDC_ENDPOINT_ORIGINS=https://identity.example.com
# OIDC_ALLOW_LOOPBACK_HTTP=0

# Optional server-only tenant map; see doc/SAAS-METERING-INTEGRATION.md
# METERING_CONNECTIONS_JSON=
# Optional published-only content source. Server-only reader credentials; see README.
# CONTENT_CONNECTIONS_JSON=
